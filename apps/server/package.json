{
  "name": "@datachat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @datachat/shared build && tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-drizzle.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "eval:nl2sql": "tsx --env-file-if-exists=../../.env scripts/eval-nl2sql.ts",
    "ops:backup": "tsx --env-file-if-exists=../../.env scripts/ops-backup.ts",
    "ops:restore": "tsx --env-file-if-exists=../../.env scripts/ops-restore.ts"
  },
  "dependencies": {
    "@datachat/shared": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.3.0",
    "@juicesharp/rpiv-ask-user-question": "2.15.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.7.0",
    "billion-context": "^0.1.213",
    "cron-parser": "^5.10.5",
    "drizzle-orm": "^0.38.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "mysql2": "^3.11.5",
    "node-sql-parser": "^5.3.4",
    "pg": "^8.13.1",
    "pg-cursor": "^2.12.1",
    "typebox": "^1.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^10.16.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
