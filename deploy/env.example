# Deployment values for docker compose (copy this file to .env next to docker-compose.yml).
# Generate with: openssl rand -hex 32
APP_SECRET=
ADMIN_USERNAME=admin
# Only used when the data volume is empty.
ADMIN_PASSWORD=

# Image tag that was built and copied to the server.
DATACHAT_VERSION=0.1.0-8e19468

# Public origin opened in the browser. Must match scheme/host/port exactly.
APP_ORIGIN=http://localhost:8080
# Session cookie Secure flag: leave empty to auto-detect from APP_ORIGIN
# (http -> false, https -> true). Set false explicitly for plain HTTP IP access.
COOKIE_SECURE=
# Host port mapped to nginx:80.
WEB_PORT=8080
LOG_LEVEL=info
