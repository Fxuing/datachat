# Deployment values for docker compose (copy this file to .env next to docker-compose.yml).
# Generate with: openssl rand -hex 32
APP_SECRET=
ADMIN_USERNAME=admin
# Only used when the data volume is empty.
ADMIN_PASSWORD=

# Prebuilt registry prefix: default `fxuing/` (Docker Hub), or `ghcr.io/fxuing/` (GHCR).
# Set empty (`IMAGE_PREFIX=`) only when using local custom-built image names.
IMAGE_PREFIX=fxuing/
# Image tag to pull or build (e.g. latest, 0.1.0).
DATACHAT_VERSION=latest

# Public origin opened in the browser. Must match scheme/host/port exactly.
APP_ORIGIN=http://localhost:5173
# Session cookie Secure flag: leave empty to auto-detect from APP_ORIGIN
# (http -> false, https -> true). Set false explicitly for plain HTTP IP access.
COOKIE_SECURE=
# Host port mapped to nginx:80.
WEB_PORT=5173
LOG_LEVEL=info

# Optional white-label branding (leave empty for default DataChat title & icon).
# APP_ICON / APP_FAVICON accept an http(s) URL, a web path (/custom/logo.png),
# or a file path mounted inside the server container (e.g. /data/branding/logo.png).
# APP_TITLE=
# APP_SUBTITLE=
# APP_ICON=
# APP_FAVICON=
