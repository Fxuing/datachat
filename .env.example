PORT=8080
# 前端开发服务器端口（Vite）；Docker Compose 也用它作为对外端口
WEB_PORT=5173
# Required: must be a real random secret, e.g. `openssl rand -hex 32`
APP_SECRET=
DATA_DIR=./data
LOG_LEVEL=info
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ADMIN_USERNAME=admin
# Optional: real password, at least 8 characters, e.g. `openssl rand -base64 24`
ADMIN_PASSWORD=
# Set true only in tests/local setups that must reach MCP servers on private addresses
MCP_ALLOW_PRIVATE_HOSTS=false
# 仅在 nginx 等反向代理之后设为 true（信任 X-Forwarded-*）
TRUST_PROXY=false
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Force session cookie Secure flag; leave empty to auto-detect from APP_ORIGIN (http -> false, https -> true)
COOKIE_SECURE=
# Optional: comma-separated datasource driver plugin packages or ESM file paths (see docs/datasource-plugin-guide.md)
# DATASOURCE_PLUGINS=./examples/driver-clickhouse/index.mjs
# DATASOURCE_PLUGINS_STRICT=false
# Allow admins to upload offline datasource driver plugin bundles via the Web UI (default true)
# ALLOW_PLUGIN_UPLOAD=true
# Optional: custom white-label branding (leave empty for default DataChat title & icon)
# APP_TITLE=DataChat
# APP_SUBTITLE=数据工作台
# APP_ICON supports an http(s) URL, a web path (/custom/logo.svg), or a local file path (e.g. ./branding/logo.png)
# APP_ICON=
# Optional: custom browser tab favicon (defaults to APP_ICON when set, or /favicon.svg)
# APP_FAVICON=
